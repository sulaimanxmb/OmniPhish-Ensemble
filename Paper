\hline
\textbf{FULL ENSEMBLE} & \textbf{97.82\% ($\pm$0.11\%)} & \textbf{98.25\%} & \textbf{97.40\%} & \textbf{0.9227} \\
\hline
\end{tabular}
}
\label{tab:ablation}
\end{center}
